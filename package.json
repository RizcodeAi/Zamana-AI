{
  "name": "zamana-ai",
  "version": "1.0.0",
  "description": "Zamana AI - Intelligent business intelligence platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:tests": "npx tsc --ignoreConfig --outDir dist --declaration false --module commonjs --target ES2022 --esModuleInterop --skipLibCheck --moduleResolution node --lib ES2022 --types node tests/*.ts src/**/*.ts",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --test dist/tests/*.test.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "zamana",
    "ai",
    "business-intelligence"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.10.9",
    "pg-mem": "^3.0.14",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}

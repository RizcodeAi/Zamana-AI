# Zamana AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
# Install PostgreSQL locally or use a managed service
# Create a database named 'zamana_ai'
DATABASE_URL="postgresql://username:password@localhost:5432/zamana_ai?schema=public"

# JWT
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=your-strong-secret-here-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Set to your frontend origin
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

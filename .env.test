# Zamana AI — Test Environment Configuration
# NEVER commit this file to git
# Keep this file local and NEVER share secrets.

# Server
PORT=3001
NODE_ENV=test

# PostgreSQL — Dedicated Test Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zamana_ai_test?schema=public

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=warn
